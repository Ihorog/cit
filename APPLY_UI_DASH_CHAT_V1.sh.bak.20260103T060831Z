cat > app.js <<'JS'
(() => {
  const API = 'http://127.0.0.1:8790';

  // UI refs
  const pillHealth = document.getElementById('pillHealth');
  const btnRefresh = document.getElementById('btnRefresh');
  const nodesGrid  = document.getElementById('nodesGrid');
  const outExec    = document.getElementById('outExec');

  // Drawer refs
  const ciFab   = document.getElementById('ciFab');
  const drawer  = document.getElementById('drawer');
  const back    = document.getElementById('drawerBackdrop');
  const btnClose= document.getElementById('btnClose');

  const chat    = document.getElementById('chat');
  const input   = document.getElementById('msg');
  const sendBtn = document.getElementById('send');
  const btnPing = document.getElementById('btnPing');
  const btnClear= document.getElementById('btnClearChat');
  const toggleTech = document.getElementById('toggleTech');
  const outTech = document.getElementById('outTech');

  const NODES = [
    { id:'ci', title:'Ci', desc:'Центр / оператор', tags:['центр','контакт'] },
    { id:'kazkar', title:'Казкар', desc:'Памʼять / легенда', tags:['земля','було'] },
    { id:'podija', title:'ПоДія', desc:'Події / ініціації', tags:['вогонь','буде'] },
    { id:'nastrij', title:'Настрій', desc:'Стан / емоції', tags:['вода','зараз'] },
    { id:'malya', title:'Маля', desc:'Ідеї / інновації', tags:['повітря','є'] },
    { id:'calendar', title:'Календар', desc:'Ритми / вузли', tags:['час','цикли'] },
    { id:'gallery', title:'Галерея', desc:'Архів / образи', tags:['медіа','історії'] },
  ];

  function pretty(x){
    try { return JSON.stringify(x, null, 2); } catch { return String(x); }
  }

  function setHealth(ok, meta){
    pillHealth.classList.remove('ok','bad');
    if(ok){
      pillHealth.classList.add('ok');
      pillHealth.textContent = `здоров'я: ok • ${meta?.model || ''} ${meta?.ts || ''}`.trim();
    } else {
      pillHealth.classList.add('bad');
      pillHealth.textContent = `здоров'я: OFFLINE`;
    }
  }

  async function fetchJSON(url, opt){
    const r = await fetch(url, opt);
    const t = await r.text();
    let j = null;
    try { j = JSON.parse(t); } catch {}
    return { ok: r.ok, status: r.status, text: t, json: j };
  }

  async function refreshHealth(){
    try{
      const r = await fetchJSON(`${API}/health`, { method:'GET' });
      if(!r.ok) return setHealth(false);
      setHealth(true, r.json);
    } catch {
      setHealth(false);
    }
  }

  function renderNodes(){
    nodesGrid.innerHTML = '';
    NODES.forEach(n => {
      const d = document.createElement('div');
      d.className = 'card';
      d.innerHTML = `
        <div class="t">${n.title}</div>
        <div class="d">${n.desc}</div>
        <div class="k">${n.tags.map(t=>`<span class="badge">${t}</span>`).join('')}</div>
      `;
      d.onclick = () => openDrawerWithSeed(n.title);
      nodesGrid.appendChild(d);
    });
  }

  function openDrawer(){ drawer.classList.add('open'); back.hidden = false; drawer.setAttribute('aria-hidden','false'); setTimeout(()=>input.focus(), 60); }
  function closeDrawer(){ drawer.classList.remove('open'); back.hidden = true; drawer.setAttribute('aria-hidden','true'); }

  function addMsg(text, cls){
    const m = document.createElement('div');
    m.className = `b ${cls}`;
    m.textContent = text;
    chat.appendChild(m);
    chat.scrollTop = chat.scrollHeight;
  }

  function openDrawerWithSeed(seed){
    openDrawer();
    addMsg(`Вузол: ${seed}. Що робимо?`, 'bot');
  }

  async function chatSend(text){
    addMsg(text, 'me');
    const payload = { message: text };
    try{
      const r = await fetchJSON(`${API}/api/chat`, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });

      if(toggleTech.checked){
        outTech.hidden = false;
        outTech.textContent = pretty(r.json ?? r.text);
      } else {
        outTech.hidden = true;
      }

      if(!r.ok){
        addMsg(`HTTP ${r.status}: ${String(r.text).slice(0,160)}`, 'bot');
        return;
      }
      const reply = r.json?.reply ?? r.json?.text ?? r.json?.message ?? (r.text || '').slice(0,200);
      addMsg(reply || '[empty]', 'bot');
    } catch(e){
      addMsg(`API error: ${String(e).slice(0,160)}`, 'bot');
    }
  }

  async function execAction(action, inputObj){
    const payload = { action, input: inputObj || {} };
    outExec.textContent = pretty(payload);

    const r = await fetchJSON(`${API}/api/exec`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });

    outExec.textContent = pretty(r.json ?? r.text);
  }

  // Wire
  ciFab.onclick = openDrawer;
  btnClose.onclick = closeDrawer;
  back.onclick = closeDrawer;

  btnRefresh.onclick = () => { refreshHealth(); };

  sendBtn.onclick = () => {
    const t = input.value.trim();
    if(!t) return;
    input.value = '';
    chatSend(t);
  };
  input.addEventListener('keydown', (e) => { if(e.key === 'Enter') sendBtn.click(); });

  btnPing.onclick = () => chatSend('ping');
  btnClear.onclick = () => { chat.innerHTML = ''; addMsg('Готовий. Пиши.', 'bot'); };

  document.querySelectorAll('[data-action]').forEach(btn => {
    btn.onclick = () => {
      const a = btn.getAttribute('data-action');
      if(a === 'actions.event.emit') return execAction(a, { name:'podija.test', payload:{ note:'hello' } });
      return execAction(a, {});
    };
  });

  // init
  renderNodes();
  refreshHealth();
  setInterval(refreshHealth, 8000);
})();
JS

