#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="/data/data/com.termux/files/home/cimeika/cit"
S="$ROOT/server/cit_server.py"
UI="$ROOT/ui"
LOG="$ROOT/logs"
REG="$ROOT/registry"

cd "$ROOT" || exit 1
mkdir -p "$LOG" "$REG"

echo "=== [STOP] old processes ==="
pkill -f "server/cit_server.py" 2>/dev/null || true
pkill -f "python -m http.server 8010" 2>/dev/null || true

echo "=== [CHECK] python ==="
python -V

echo "=== [CHECK] cit_server.py syntax ==="
python -m py_compile "$S"

echo "=== [START] CIT API :8790 ==="
nohup python "$S" > "$LOG/cit_api_8790.log" 2>&1 &
sleep 0.8

echo "=== [START] UI :8010 ==="
cd "$UI" || exit 1
nohup python -m http.server 8010 --bind 127.0.0.1 > "$LOG/ui_8010.log" 2>&1 &
sleep 0.4
cd "$ROOT" || exit 1

echo "=== [VERIFY] API health ==="
curl -sS --max-time 2 http://127.0.0.1:8790/health || echo "API DOWN"
echo

echo "=== [VERIFY] Chat bridge ==="
curl -sS --max-time 6 -X POST http://127.0.0.1:8790/api/chat \
  -H "Content-Type: application/json" \
  -d '{"message":"ping"}' || echo "CHAT FAIL"
echo

echo "=== [VERIFY] Registry (exec) ==="
curl -sS --max-time 2 -X POST http://127.0.0.1:8790/api/exec \
  -H "Content-Type: application/json" \
  -d '{"action":"actions.registry.get","input":{}}' || echo "REGISTRY FAIL"
echo

echo "=== [VERIFY] Node-packages (exec) ==="
curl -sS --max-time 2 -X POST http://127.0.0.1:8790/api/exec \
  -H "Content-Type: application/json" \
  -d '{"action":"actions.node_packages.get","input":{}}' || echo "NODE_PACKAGES FAIL"
echo

echo "=== [VERIFY] UI ==="
curl -sS --max-time 2 -I http://127.0.0.1:8010/ | head -n 1 || echo "UI DOWN"
echo

echo "=== READY LINKS ==="
echo "UI            : http://127.0.0.1:8010/"
echo "API health    : http://127.0.0.1:8790/health"
echo "API chat      : http://127.0.0.1:8790/api/chat"
echo "API exec      : http://127.0.0.1:8790/api/exec"
echo "Registry (GET): http://127.0.0.1:8790/registry"
echo "Node-packages : http://127.0.0.1:8790/node-packages"


# === CANON UI RESTART (Termux) ===
UI_PORT=8010
UI_HOST=127.0.0.1
ROOT="/data/data/com.termux/files/home/cimeika/cit/ui"
LOGDIR="/data/data/com.termux/files/home/cimeika/cit/logs"
LOGFILE="$LOGDIR/ui_${UI_PORT}.log"

mkdir -p "$LOGDIR" || exit 1

# stop
pids="$(ps -A -o pid,args | grep -E "python -m http\.server $UI_PORT" | grep -v grep | awk '{print $1}' || true)"
for pid in $pids; do kill -9 "$pid" 2>/dev/null || true; done
sleep 0.2

# start
cd "$ROOT" || exit 1
nohup python -m http.server "$UI_PORT" --bind "$UI_HOST" > "$LOGFILE" 2>&1 &
sleep 0.4

# verify
curl -sS --max-time 2 -I "http://$UI_HOST:$UI_PORT/" | head -n 1
# === /CANON UI RESTART ===
