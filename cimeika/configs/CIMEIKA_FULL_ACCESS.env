# CIMEIKA FULL ACCESS ENVIRONMENT CONFIGURATION
# Template for all required API keys and configuration

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_org_id_if_applicable

# HuggingFace Configuration
HF_TOKEN=your_huggingface_token_here
HF_SPACE_URL=https://ihorog-cimeika-api.hf.space

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN_CIMEIKA=your_cimeika_bot_token
TELEGRAM_BOT_TOKEN_KAZKAR=your_kazkar_bot_token
TELEGRAM_BOT_TOKEN_UI=your_ui_bot_token
TELEGRAM_CHANNEL_ID=@ci_channel

# Database Configuration
MYSQL_HOST=um542319.mysql.tools
MYSQL_PORT=3306
MYSQL_USER=um542319
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=um542319_db

# Hosting Configuration
FTP_HOST=um542319.ftp.tools
FTP_USER=um542319
FTP_PASSWORD=your_ftp_password

# API Configuration
CIMEIKA_API_URL=https://api.cimeika.com.ua
LOCAL_API_PORT=8790
WEB_UI_PORT=8000

# System Configuration
PYTHONPATH=/vercel/sandbox
LOG_LEVEL=INFO
AUTO_SYNC_INTERVAL=3600

# GitHub Actions Secrets (set in repository settings)
# GITHUB_TOKEN - automatically provided
# VERCEL_TOKEN - for deployment
# DOCKER_HUB_TOKEN - for container registry